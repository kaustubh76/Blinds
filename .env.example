# Copy to .env. Nothing here is required for `cargo test` (LiteSVM) or `make test-integration`.
WINDOW_PROFILE=demo                # demo | integration | prod (config/<profile>.toml)
WINDOW_CLUSTER=localnet            # localnet | devnet
WINDOW_RPC_URL=http://127.0.0.1:8899
WINDOW_ADMIN_KEYPAIR=~/.config/solana/id.json   # single disclosed key: administrator+keeper+operator+price poster
WINDOW_AUDITOR_SEED_HEX=           # 32-byte hex; derives the auditor ElGamal keypair (leave empty on localnet: generated by setup)
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_FEED_ID=                      # hex feed id of the 24/7 xStock feed used for the demo asset
INDEXER_PORT=8787
INDEXER_DB=services/indexer/data/window.sqlite
VITE_INDEXER_URL=http://127.0.0.1:8787
