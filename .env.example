# Copy to .env. Nothing here is required for `cargo test` (LiteSVM) or `make test-integration`.
WINDOW_PROFILE=demo                # demo | integration | devnet | prod (config/<profile>.toml)
WINDOW_CLUSTER=localnet            # localnet | devnet
WINDOW_RPC_URL=http://127.0.0.1:8899
WINDOW_ADMIN_KEYPAIR=~/.config/solana/id.json   # single disclosed key: administrator+keeper+operator+price poster
WINDOW_AUDITOR_SEED_HEX=           # 32-byte hex; derives the auditor ElGamal keypair (leave empty on localnet: generated by setup)
# Each [[listings]] block in config/<profile>.toml names its price source. The Pyth listing reads
# Pyth's on-chain PriceUpdateV2 accounts (price_account / price_rpc_url) unless PYTH_API_KEY is set.
# Override the mainnet RPC those accounts are read from if the public endpoint rate-limits you.
WINDOW_PRICE_RPC_URL=
PYTH_FEED_ID=                      # optional override of the profile's feed id (32 bytes hex)
# Pyth Pro API key (https://pythdata.app) — keeper only, never the app. With it the keeper reads
# Hermes; without it (or when Hermes fails) it reads Pyth's on-chain accounts. Verify with
# `window-admin price-check`.
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
# With the key, scripts/market.sh also starts services/pyth-poster, which posts Pyth's signed update
# into Pyth's receiver on this cluster (listing `pyth_shard`) so a `price_source = 4` listing reads
# Pyth's own account (docs/PYTH.md). Cadence in seconds:
PYTH_POST_EVERY_SECS=60
WINDOW_PRIORITY_FEE_MICROLAMPORTS=0   # per compute unit on service transactions; 1000 is sane on devnet
WINDOW_AGENT_FUNDING_LAMPORTS=150000000   # SOL given to each simulated agent at setup (0.15)
WINDOW_JOIN_FUNDING_LAMPORTS=100000000    # SOL the /join faucet sends a judge's wallet (0.10)
# Dashboard (app/.env). It reads the chain directly through the SDK; the admin service only provides
# the deployment descriptor and the demo faucet.
VITE_CLUSTER=localnet
VITE_RPC_URL=http://127.0.0.1:8899
VITE_ADMIN_URL=http://127.0.0.1:9090
# The lender agent's token launch (services/launch, docs/TRACKS.md Part B). `pnpm --filter @thewindow/launch
# plan|launch|status|buy <quote>|graduate|agent`. Reads and writes deployments/launch-<cluster>.json.
LAUNCH_CLUSTER=devnet              # devnet (a twin quote mint, rehearsal) | mainnet (TSLAx is the quote)
LAUNCH_RPC_URL=                    # default: the cluster's public RPC
WINDOW_LAUNCH_KEYPAIR=~/.config/solana/id.json   # pays the pool's rent and signs; on mainnet a dedicated key with ~0.05 SOL
LAUNCH_CREATOR=                    # the pool's creator = the fee wallet; the Clawpump agent wallet once `agent` has run
LAUNCH_INITIAL_USD=25000           # fully diluted value at the first tick, in USD, converted to the quote stock via Pyth
LAUNCH_MIGRATION_USD=250000        # fully diluted value at graduation; the raise threshold follows from the curve
LAUNCH_RAISE_TO_AGENT_PCT=10       # share of the graduated raise paid to the creator (the rest is locked LP)
LAUNCH_NEW_QUOTE=                  # devnet only: set to mint a fresh twin quote instead of reusing the recorded one
# Clawpump (https://clawpump.tech/developers). `agent` reuses the key's one agent (renamed) or creates one and
# records id + walletAddress; that wallet is the Meteora pool's creator and fee claimer. `clawpump-launch`
# has Clawpump launch the agent's identity coin on pump.fun, paired with TSLAx — the AGENT WALLET pays
# (~0.01 SOL), so fund it first. Two addresses to fund on mainnet: the launch key (~0.05) and the agent wallet (~0.02).
CLAWPUMP_API_KEY=
CLAWPUMP_AGENT_ID=                 # optional: which agent when the key owns several
CLAWPUMP_AGENT_NAME=The Window Lender
CLAWPUMP_TOKEN_SYMBOL=LENDER       # the identity coin (WLEND is the Meteora capital token)
CLAWPUMP_TOKEN_IMAGE_URL=https://kaustubh76.github.io/Blinds/launch/lender.png
