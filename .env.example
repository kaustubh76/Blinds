# Copy to .env. Nothing here is required for `cargo test` (LiteSVM) or `make test-integration`.
WINDOW_PROFILE=demo                # demo | integration | prod (config/<profile>.toml)
WINDOW_CLUSTER=localnet            # localnet | devnet
WINDOW_RPC_URL=http://127.0.0.1:8899
WINDOW_ADMIN_KEYPAIR=~/.config/solana/id.json   # single disclosed key: administrator+keeper+operator+price poster
WINDOW_AUDITOR_SEED_HEX=           # 32-byte hex; derives the auditor ElGamal keypair (leave empty on localnet: generated by setup)
# The price comes from Pyth's on-chain PriceUpdateV2 account named by the profile
# (config/<profile>.toml -> assets.mock_tsla.price_account / price_rpc_url); no API key. Override the
# RPC it is read from here if the public mainnet endpoint rate-limits you.
WINDOW_PRICE_RPC_URL=
PYTH_FEED_ID=                      # optional override of the profile's feed id (32 bytes hex)
# Pyth Pro API key (https://pythdata.app) — keeper only, never the app. With it the keeper reads
# Hermes; without it (or when Hermes fails) it reads Pyth's on-chain accounts. Verify with
# `window-admin price-check`.
PYTH_API_KEY=
PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
WINDOW_PRIORITY_FEE_MICROLAMPORTS=0   # per compute unit on service transactions; 1000 is sane on devnet
WINDOW_AGENT_FUNDING_LAMPORTS=150000000   # SOL given to each simulated agent at setup (0.15)
WINDOW_JOIN_FUNDING_LAMPORTS=100000000    # SOL the /join faucet sends a judge's wallet (0.10)
# Dashboard (app/.env). It reads the chain directly through the SDK; the admin service only provides
# the deployment descriptor and the demo faucet.
VITE_CLUSTER=localnet
VITE_RPC_URL=http://127.0.0.1:8899
VITE_ADMIN_URL=http://127.0.0.1:9090
