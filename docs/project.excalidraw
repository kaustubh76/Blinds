      "versionNonce": 1450232771,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "System · ATA · Instructions sysvar\nSolana's built-ins: creating\n  accounts (System), the standard\ntoken-account address scheme\n  (ATA), and a way for a program\nto look at the other instructions\n  in the same transaction —\nwhich is how \"the proof must\n  come right before this call\"\nand \"the transfer must come\n  right before this call\" are\nenforced (every program's zk.rs).",
      "originalText": "System · ATA · Instructions sysvar\nSolana's built-ins: creating\n  accounts (System), the standard\ntoken-account address scheme\n  (ATA), and a way for a program\nto look at the other instructions\n  in the same transaction —\nwhich is how \"the proof must\n  come right before this call\"\nand \"the transfer must come\n  right before this call\" are\nenforced (every program's zk.rs).",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "p.x.sys",
      "autoResize": true,
      "lineHeight": 1.25
    },
