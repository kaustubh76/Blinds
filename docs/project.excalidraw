      "seed": 2030904506,
      "version": 1,
      "versionNonce": 1162923576,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "HONEST LIMITATIONS — SPEC §14, the short list\nThe administrator can decrypt individual amounts · who takes\npart is public · mock collateral · marks copied by the keeper\nexcept on source 4 · no margin calls, an illustrative haircut ·\nfunding amounts attested · escrow held by the operator · one\nkey for four roles · simulated members · not a regulated\nbenchmark or a broker · depends on Solana's proof program ·\nunaudited, single tenor, no real value.",
      "originalText": "HONEST LIMITATIONS — SPEC §14, the short list\nThe administrator can decrypt individual amounts · who takes\npart is public · mock collateral · marks copied by the keeper\nexcept on source 4 · no margin calls, an illustrative haircut ·\nfunding amounts attested · escrow held by the operator · one\nkey for four roles · simulated members · not a regulated\nbenchmark or a broker · depends on Solana's proof program ·\nunaudited, single tenor, no real value.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "rm.s14",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "rm.amend",
      "type": "rectangle",
      "x": 3080,
      "y": 5224,
      "width": 520,
      "height": 244,
      "angle": 0,
      "strokeColor": "#1f2937",
      "backgroundColor": "#f3f4f6",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "g.rm.amend"
