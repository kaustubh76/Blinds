    {
      "id": "lc.e.h.t",
      "type": "text",
      "x": 576.5,
      "y": 968,
      "width": 367,
      "height": 228,
      "angle": 0,
      "strokeColor": "#065f46",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
