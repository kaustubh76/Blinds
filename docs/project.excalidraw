      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Pyth Hermes — Pyth's web API (needs PYTH_API_KEY, used only by the bots)\nReturns the latest price with the publisher's own\n  timestamp, and the signed message the poster\nforwards to Pyth's on-chain receiver. Without a\n  key the keeper falls back to reading Pyth's\nexisting on-chain price accounts (the freshest of\n  them, owner and feed checked); the browser\nreads the same accounts through a public RPC.",
      "originalText": "Pyth Hermes — Pyth's web API (needs PYTH_API_KEY, used only by the bots)\nReturns the latest price with the publisher's own\n  timestamp, and the signed message the poster\nforwards to Pyth's on-chain receiver. Without a\n  key the keeper falls back to reading Pyth's\nexisting on-chain price accounts (the freshest of\n  them, owner and feed checked); the browser\nreads the same accounts through a public RPC.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "tr.py.hermes",
      "autoResize": true,
      "lineHeight": 1.25
    },
