      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "OPERATIONS — scripts/\nmarket.sh start | stop | status |\n  tunnel — runs the bots and\nthe poster, opens the tunnel\n  for the faucet, prints the\nshare link for the hosted dashboard.\nwatch_tunnels.sh keeps the tunnels alive; serve_app.sh\nserves the app itself if hosting\n  is down; localnet.sh runs\neverything on a laptop; deploy /\n  upgrade scripts for devnet;\nfreeze.sh makes the programs\n  immutable — irreversible, the\nvery last step, only on the user's go.",
      "originalText": "OPERATIONS — scripts/\nmarket.sh start | stop | status |\n  tunnel — runs the bots and\nthe poster, opens the tunnel\n  for the faucet, prints the\nshare link for the hosted dashboard.\nwatch_tunnels.sh keeps the tunnels alive; serve_app.sh\nserves the app itself if hosting\n  is down; localnet.sh runs\neverything on a laptop; deploy /\n  upgrade scripts for devnet;\nfreeze.sh makes the programs\n  immutable — irreversible, the\nvery last step, only on the user's go.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "sv.tunnels",
      "autoResize": true,
      "lineHeight": 1.25
    },
