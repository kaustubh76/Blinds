    {
      "id": "tr.ps.h.t",
      "type": "text",
      "x": 28,
      "y": 3439,
      "width": 542,
      "height": 163,
      "angle": 0,
      "strokeColor": "#c2410c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
