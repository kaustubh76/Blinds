      "seed": 976971100,
      "version": 1,
      "versionNonce": 631079980,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "THE KEEPER LOOP — keeper.rs, every tick\nNo round open → open one and\n  post every listing's price.\nRound past its length → close it.\nRepost a listing's price when its cache is half-way to\nstale (a dead source is posted with its true, old\ntimestamp — the chain will refuse it).\nSeize any loan past its deadline\n  (with that listing's price).\nRefund bid rent once a round has settled.",
      "originalText": "THE KEEPER LOOP — keeper.rs, every tick\nNo round open → open one and\n  post every listing's price.\nRound past its length → close it.\nRepost a listing's price when its cache is half-way to\nstale (a dead source is posted with its true, old\ntimestamp — the chain will refuse it).\nSeize any loan past its deadline\n  (with that listing's price).\nRefund bid rent once a round has settled.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "sv.keeper",
      "autoResize": true,
      "lineHeight": 1.25
    },
