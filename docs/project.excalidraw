      "updated": 1,
      "link": null,
      "locked": false,
      "text": "OPEN\nopen_epoch · keeper · a new\n  Epoch account is created and\nstamped with the auditor key.\nMembers submit sealed bids; the\n  chain adds the encrypted\nsizes per tick. The keeper\n  posts every listing's price.",
      "originalText": "OPEN\nopen_epoch · keeper · a new\n  Epoch account is created and\nstamped with the auditor key.\nMembers submit sealed bids; the\n  chain adds the encrypted\nsizes per tick. The keeper\n  posts every listing's price.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "lc.e.open",
      "autoResize": true,
      "lineHeight": 1.25
    },
