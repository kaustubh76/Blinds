      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "privacy — the leak budget, enforced\nNo instruction of any program\n  takes an amount (an allow-list\nof numeric fields), and a scan of\n  every account, transaction\nand log after a full round and\n  two loans finds no secret in\nplaintext. Repeated over RPC in tier 2 and on devnet.",
      "originalText": "privacy — the leak budget, enforced\nNo instruction of any program\n  takes an amount (an allow-list\nof numeric fields), and a scan of\n  every account, transaction\nand log after a full round and\n  two loans finds no secret in\nplaintext. Repeated over RPC in tier 2 and on devnet.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "ts.t1.privacy",
      "autoResize": true,
      "lineHeight": 1.25
    },
