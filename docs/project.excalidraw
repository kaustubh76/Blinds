      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 841414375,
      "version": 1,
      "versionNonce": 555079914,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "KEYS — where they come from\nMember key: derived from a wallet signature of a fixed\nmessage (\"thewindow:member:v1\");\n  a second signature per mint\nsets up the confidential token account.\nAuditor key: derived from the\n  administrator's secret seed,\nwhich also derives the escrow and the agents' keys.\nEach round stamps the auditor\n  key it was sealed under; the\nkey can only rotate between rounds.\ncrates/window-elgamal/src/keys.rs · sdk/src/keys.ts",
      "originalText": "KEYS — where they come from\nMember key: derived from a wallet signature of a fixed\nmessage (\"thewindow:member:v1\");\n  a second signature per mint\nsets up the confidential token account.\nAuditor key: derived from the\n  administrator's secret seed,\nwhich also derives the escrow and the agents' keys.\nEach round stamps the auditor\n  key it was sealed under; the\nkey can only rotate between rounds.\ncrates/window-elgamal/src/keys.rs · sdk/src/keys.ts",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "ac.keys",
      "autoResize": true,
      "lineHeight": 1.25
    },
