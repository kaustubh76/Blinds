    {
      "id": "ac.keys.t",
      "type": "text",
      "x": 28,
      "y": 3058,
      "width": 422,
      "height": 195,
      "angle": 0,
      "strokeColor": "#4338ca",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
