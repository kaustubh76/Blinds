    {
      "id": "tr.ps.api.t",
      "type": "text",
      "x": 28,
      "y": 3644,
      "width": 456,
      "height": 147,
      "angle": 0,
      "strokeColor": "#c2410c",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "g.tr.ps.api"
      ],
      "frameId": null,
      "index": null,
      "roundness": null,
      "seed": 166704422,
      "version": 1,
      "versionNonce": 367929053,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "PreStocks public API — an ATTESTED mark, not a signed feed\nThe keeper fetches the published mark price from\n  PreStocks' web API and posts it with the\nFETCH time as its timestamp; the chain, the config\n  and the dashboard all label it \"attested\".\nThe 48-hour freshness limit is therefore a promise\n  that the keeper keeps fetching; if the API\ndies the last mark is re-posted for a few hours,\n  then the rule halts new locks on that listing.",
      "originalText": "PreStocks public API — an ATTESTED mark, not a signed feed\nThe keeper fetches the published mark price from\n  PreStocks' web API and posts it with the\nFETCH time as its timestamp; the chain, the config\n  and the dashboard all label it \"attested\".\nThe 48-hour freshness limit is therefore a promise\n  that the keeper keeps fetching; if the API\ndies the last mark is re-posted for a few hours,\n  then the rule halts new locks on that listing.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "tr.ps.api",
      "autoResize": true,
      "lineHeight": 1.25
    },
